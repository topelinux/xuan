set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mipsel)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# Allow older kernels lacking time64 syscalls.
set(TJS_MIPS_TIME_BITS "32" CACHE STRING "time_t width for MIPS cross build")
set(TJS_MIPS_TARGET "mipsel-linux-musleabi" CACHE STRING "Zig target triple")
set(TJS_MIPS_CPU "mips32r2" CACHE STRING "MIPS CPU tuning")
set(TJS_MIPS_FLOAT_ABI "-msoft-float" CACHE STRING "Floating-point ABI")
set(TJS_LINK_MODE "static" CACHE STRING "Link mode: static|dynamic")

set(_tjs_default_sysroot "${CMAKE_CURRENT_LIST_DIR}/../../mips_root/target-mipsel_24kc_musl")
if(NOT DEFINED TJS_MIPS_SYSROOT)
    set(TJS_MIPS_SYSROOT "${_tjs_default_sysroot}" CACHE PATH "OpenWrt target sysroot root")
endif()

set(CMAKE_C_COMPILER zig)
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER zig)
set(CMAKE_CXX_COMPILER_ARG1 c++)
set(CMAKE_ASM_COMPILER zig)
set(CMAKE_ASM_COMPILER_ARG1 cc)

set(_tjs_common_flags "-target ${TJS_MIPS_TARGET} ${TJS_MIPS_FLOAT_ABI} -mcpu=${TJS_MIPS_CPU} -mxgot")
set(CMAKE_C_FLAGS_INIT "${_tjs_common_flags} -D_TIME_BITS=${TJS_MIPS_TIME_BITS}")
set(CMAKE_CXX_FLAGS_INIT "${_tjs_common_flags} -D_TIME_BITS=${TJS_MIPS_TIME_BITS}")
set(CMAKE_ASM_FLAGS_INIT "${_tjs_common_flags}")
if(TJS_LINK_MODE STREQUAL "static")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "${_tjs_common_flags} -static")
    set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")
elseif(TJS_LINK_MODE STREQUAL "dynamic")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "${_tjs_common_flags} -dynamic")
    set(CMAKE_FIND_LIBRARY_SUFFIXES ".so" ".a")
else()
    message(FATAL_ERROR "Unsupported TJS_LINK_MODE=${TJS_LINK_MODE}, expected static or dynamic")
endif()

if(DEFINED TJS_MIPS_SYSROOT AND EXISTS "${TJS_MIPS_SYSROOT}")
    list(APPEND CMAKE_FIND_ROOT_PATH "${TJS_MIPS_SYSROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
