set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(TJS_AARCH64_TARGET "aarch64-linux-gnu" CACHE STRING "Zig target triple")
set(TJS_AARCH64_CPU "generic" CACHE STRING "AArch64 CPU tuning")
set(TJS_LINK_MODE "dynamic" CACHE STRING "Link mode: static|dynamic")

set(_tjs_default_sysroot "${CMAKE_CURRENT_LIST_DIR}/../../aarch64_root/target-aarch64-linux-gnu")
if(NOT DEFINED TJS_AARCH64_SYSROOT)
    set(TJS_AARCH64_SYSROOT "${_tjs_default_sysroot}" CACHE PATH "AArch64 target sysroot root")
endif()

set(CMAKE_C_COMPILER zig)
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER zig)
set(CMAKE_CXX_COMPILER_ARG1 c++)
set(CMAKE_ASM_COMPILER zig)
set(CMAKE_ASM_COMPILER_ARG1 cc)

set(_tjs_common_flags "-target ${TJS_AARCH64_TARGET} -mcpu=${TJS_AARCH64_CPU}")
set(CMAKE_C_FLAGS_INIT "${_tjs_common_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_tjs_common_flags}")
set(CMAKE_ASM_FLAGS_INIT "${_tjs_common_flags}")

if(TJS_LINK_MODE STREQUAL "static")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "${_tjs_common_flags} -static")
    set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")
elseif(TJS_LINK_MODE STREQUAL "dynamic")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "${_tjs_common_flags} -dynamic")
    set(CMAKE_FIND_LIBRARY_SUFFIXES ".so" ".a")
else()
    message(FATAL_ERROR "Unsupported TJS_LINK_MODE=${TJS_LINK_MODE}, expected static or dynamic")
endif()

if(DEFINED TJS_AARCH64_SYSROOT AND EXISTS "${TJS_AARCH64_SYSROOT}")
    list(APPEND CMAKE_FIND_ROOT_PATH "${TJS_AARCH64_SYSROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
