set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(TJS_WIN_TARGET "x86_64-windows-gnu" CACHE STRING "Zig target triple")
set(TJS_WIN_CPU "x86_64" CACHE STRING "Windows CPU tuning")
set(TJS_LINK_MODE "static" CACHE STRING "Link mode: static|dynamic")

set(CMAKE_C_COMPILER zig)
set(CMAKE_C_COMPILER_ARG1 "cc -target ${TJS_WIN_TARGET}")
set(CMAKE_CXX_COMPILER zig)
set(CMAKE_CXX_COMPILER_ARG1 "c++ -target ${TJS_WIN_TARGET}")
set(CMAKE_ASM_COMPILER zig)
set(CMAKE_ASM_COMPILER_ARG1 "cc -target ${TJS_WIN_TARGET}")
set(CMAKE_AR "${CMAKE_CURRENT_LIST_DIR}/zig-ar" CACHE FILEPATH "Archiver" FORCE)
set(CMAKE_RANLIB "${CMAKE_CURRENT_LIST_DIR}/zig-ranlib" CACHE FILEPATH "Ranlib" FORCE)
# Ensure stale build dirs regenerate static libs with Zig archiver tools.
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>" CACHE STRING "" FORCE)
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_RANLIB> <TARGET>" CACHE STRING "" FORCE)
set(CMAKE_CXX_ARCHIVE_CREATE "<CMAKE_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>" CACHE STRING "" FORCE)
set(CMAKE_CXX_ARCHIVE_FINISH "<CMAKE_RANLIB> <TARGET>" CACHE STRING "" FORCE)

set(_tjs_common_flags "-target ${TJS_WIN_TARGET} -mcpu=${TJS_WIN_CPU}")
set(CMAKE_C_FLAGS_INIT "${_tjs_common_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_tjs_common_flags}")
set(CMAKE_ASM_FLAGS_INIT "${_tjs_common_flags}")

if(TJS_LINK_MODE STREQUAL "static")
  set(CMAKE_EXE_LINKER_FLAGS_INIT "${_tjs_common_flags} -static")
  set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")
elseif(TJS_LINK_MODE STREQUAL "dynamic")
  set(CMAKE_EXE_LINKER_FLAGS_INIT "${_tjs_common_flags}")
  set(CMAKE_FIND_LIBRARY_SUFFIXES ".dll.a" ".a")
else()
  message(FATAL_ERROR "Unsupported TJS_LINK_MODE=${TJS_LINK_MODE}, expected static or dynamic")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Disable WAMR for Windows cross-compilation (requires Windows-specific headers)
set(TJS_DISABLE_WASM ON CACHE BOOL "Disable WebAssembly runtime" FORCE)
set(TJS_DISABLE_NATIVE_MODULES ON CACHE BOOL "Disable native modules" FORCE)
